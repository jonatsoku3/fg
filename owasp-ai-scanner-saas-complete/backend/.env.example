# Server Configuration
PORT=3001

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OWASP ZAP Configuration
# Default: http://localhost:8081 (for Docker on Windows)
# For Docker on Mac/Linux: http://host.docker.internal:8081
ZAP_URL=http://localhost:8081

# Test Mode Configuration
# Set to 'true' to use mock vulnerability data for testing (bypasses ZAP)
# Set to 'false' to use real OWASP ZAP scanning
USE_MOCK_DATA=false
